# retell-hermes-voice configuration
# Copy to .env and fill in the three required values. Everything else is optional;
# commented lines show the default.

# --- required ---------------------------------------------------------------

# Hermes API server base URL (API_SERVER_ENABLED=true in ~/.hermes/.env)
RHV_HERMES_BASE_URL=http://127.0.0.1:8642

# Bearer token: must match API_SERVER_KEY in the Hermes profile's .env
RHV_HERMES_API_KEY=replace-with-your-hermes-api-server-key

# Unguessable WebSocket path segment, minimum 16 chars (use 32+).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RHV_ROUTE_SECRET=generate-with-python-secrets-token-urlsafe-32

# --- listener ----------------------------------------------------------------

# Bind address/port. Keep loopback; terminate WSS at a reverse proxy.
#RHV_LISTEN_HOST=127.0.0.1
#RHV_LISTEN_PORT=8765

# --- caller policy -----------------------------------------------------------

# Comma-separated E.164 allowlist. Empty = allowlist DISABLED (allow all, warn).
#RHV_ALLOWED_CALLERS=+15550000001,+15550000002

# --- voice behavior ----------------------------------------------------------

# Inbound-call opening line.
#RHV_GREETING=Hi, this is the assistant. How can I help?

# Outbound opening template; {assistant_name}, {principal}, {purpose} placeholders.
# Default states identity and a recording disclosure.
#RHV_OUTBOUND_OPENING=Hi, this is {assistant_name}, {principal}'s assistant. Just so you know, this call may be recorded. {purpose}

# Identity used in the outbound opening.
#RHV_ASSISTANT_NAME=the assistant
#RHV_PRINCIPAL=the operator

# Comma-separated holding lines spoken during dead air (must be non-empty).
# Default: 8 built-in phrases.
#RHV_FILLER_PHRASES=One moment while I check.,Let me pull that up for you.

# Seconds of dead air before a filler phrase is spoken.
#RHV_FILLER_AFTER_SECONDS=1.5

# --- hermes routing (latency) --------------------------------------------------
# Routed model is ~5x faster to first token than the Hermes default route.
# Always set model and provider together.

#RHV_VOICE_MODEL=google/gemini-3.7-flash
#RHV_VOICE_PROVIDER=openrouter
#RHV_VOICE_REASONING_EFFORT=low

# Fire one tiny routed run at startup to absorb provider cold start (up to 24s).
#RHV_WARMUP_ON_START=true

# --- timeouts / limits ---------------------------------------------------------

#RHV_HERMES_CONNECT_TIMEOUT=5.0
#RHV_HERMES_FIRST_TOKEN_TIMEOUT=15.0
#RHV_HERMES_TURN_TIMEOUT=60.0
#RHV_HERMES_STOP_TIMEOUT=3.0

# Adapter call semaphore; keep below Hermes max_concurrent_runs (default 10).
#RHV_MAX_CONCURRENT_CALLS=5

#RHV_MAX_TRANSCRIPT_UTTERANCES=200
#RHV_MAX_WS_MESSAGE_BYTES=1000000

# "none" = per-call random Hermes session ids; "hermes" = let Hermes persist sessions.
#RHV_SESSION_RETENTION=none

# Advisory tool policy (prompt-shaping only; real enforcement is the Hermes profile).
#RHV_TOOL_POLICY__ENABLED_TOOLS=
#RHV_TOOL_POLICY__CONFIRM_TOOLS=
#RHV_TOOL_POLICY__MAX_TOOL_CALLS_PER_TURN=3
#RHV_TOOL_POLICY__MAX_TOOL_SECONDS_PER_CALL=60.0

# Transcript content is never logged.
